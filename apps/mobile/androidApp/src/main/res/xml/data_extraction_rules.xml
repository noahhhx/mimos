<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted refresh token cannot be opened without its Keystore key,
     which never leaves the device, so a restored copy would only fail. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
