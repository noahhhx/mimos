<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted refresh token cannot be opened without its Keystore key,
     which never leaves the device, so a restored copy would only fail. The
     stored shopping list belongs to that session (ADR-0034): restored without
     it, it would only be cleared. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="shopping.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="shopping.xml" />
    </device-transfer>
</data-extraction-rules>
