{
  "name": "mimos",
  "private": true,
  "workspaces": [
    "apps/*",
    "libraries/*",
    "plugins/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write ."
  }
}
