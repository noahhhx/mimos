{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "apps/web/**",
      "tools/**",
      "plugins/**",
      "libraries/**",
      "!libraries/*/src/client",
      "!**/*.gen.ts",
      "!**/*.css",
      "!libraries/test-cases"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "overrides": [
    {
      "includes": ["tools/harness/src/**"],
      "linter": { "rules": { "correctness": { "usePlaywrightValidDescribeCallback": "off" } } }
    },
    {
      "includes": ["tools/harness/scenarios/**"],
      "linter": { "rules": { "performance": { "useDomNodeTextContent": "off" } } }
    }
  ]
}
