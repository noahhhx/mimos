  "estimateCases": [
    {
      "name": "sends the named, validly measured rows, without notes, and remembers where each came from",
      "patch": {
        "servings": "4",
        "ingredients": [
          { "quantity": "", "unit": "", "name": "" },
          { "quantity": "250", "unit": " g ", "name": "red lentils", "note": "rinsed", "catalogSlug": "red-lentils" },
          { "quantity": "-1", "unit": "", "name": "carrots" },
          { "quantity": "", "unit": "", "name": "salt", "catalogSlug": "" },
          { "quantity": "2", "unit": "servings", "name": "focaccia", "recipeId": "r-1" }
        ]
      },
      "expected": {
        "input": {
          "servings": 4,
          "ingredients": [
            { "quantity": 250, "unit": "g", "name": "red lentils", "catalogSlug": "red-lentils" },
            { "name": "salt" },
            { "quantity": 2, "unit": "servings", "name": "focaccia", "recipeId": "r-1" }
          ]
        },
        "rows": [1, 3, 4]
      }
    },
    {
      "name": "estimates up to 50 servings",
      "patch": { "servings": "50" },
      "expected": {
        "input": { "servings": 50, "ingredients": [{ "quantity": 1, "unit": "l", "name": "stock" }] },
        "rows": [0]
      }
    },
    { "name": "waits for servings to be typed", "patch": { "servings": "" }, "expected": null },
    { "name": "waits for a whole number of servings", "patch": { "servings": "2.5" }, "expected": null },
    { "name": "waits for at least one serving", "patch": { "servings": "0" }, "expected": null },
    { "name": "waits for at most 50 servings", "patch": { "servings": "51" }, "expected": null }
