    "ingredients": [{ "quantity": "1", "unit": "l", "name": "stock" }],
    "steps": ["Simmer."]
  },
  "inputCases": [
    {
      "name": "leaves a blank amount out: an unmeasured ingredient",
      "patch": {
        "ingredients": [
          { "quantity": "", "unit": "", "name": " salt, to taste " },
          { "quantity": "1", "unit": "l", "name": "stock" }
        ]
      },
      "expected": {
        "input": {
          "ingredients": [{ "name": "salt, to taste" }, { "quantity": 1, "unit": "l", "name": "stock" }]
        }
      }
    },
    {
      "name": "skips untouched rows and blank steps",
      "patch": {
        "ingredients": [
          { "quantity": "1", "unit": "l", "name": "stock" },
          { "quantity": "", "unit": "", "name": "" }
        ],
        "steps": ["Simmer.", "  "]
      },
      "expected": {
        "input": {
          "ingredients": [{ "quantity": 1, "unit": "l", "name": "stock" }],
          "steps": [{ "instruction": "Simmer." }]
        }
      }
    },
    {
      "name": "names a row with no name",
      "patch": { "ingredients": [{ "quantity": "2", "unit": "cups", "name": "" }] },
      "expected": { "errors": ["Ingredient 1 needs a name."] }
    },
    {
      "name": "rejects a zero amount, naming the row",
      "patch": {
        "ingredients": [
          { "quantity": "1", "unit": "l", "name": "stock" },
          { "quantity": "0", "unit": "", "name": "salt" }
        ]
      },
      "expected": { "errors": ["Ingredient 2's amount must be more than 0, or leave it blank for \"to taste\"."] }
    },
    {
      "name": "rejects a negative amount and one that is not a number",
      "patch": {
        "ingredients": [
          { "quantity": "-1", "unit": "", "name": "salt" },
          { "quantity": "1,5", "unit": "l", "name": "stock" }
        ]
      },
      "expected": {
        "errors": [
          "Ingredient 1's amount must be more than 0, or leave it blank for \"to taste\".",
          "Ingredient 2's amount must be more than 0, or leave it blank for \"to taste\"."
        ]
      }
    },
    {
      "name": "asks for a title, a description, an ingredient, and a step",
      "patch": {
        "title": "  ",
        "description": "",
        "ingredients": [{ "quantity": "", "unit": "", "name": "" }],
        "steps": [""]
      },
      "expected": {
        "errors": [
          "Give the recipe a title.",
          "Give the recipe a description.",
          "Add at least one ingredient.",
          "Add at least one step."
        ]
      }
    },
    {
      "name": "lowercases tags and keeps each once",
      "patch": { "tags": "Dinner, dinner , soup,," },
      "expected": { "input": { "tags": ["dinner", "soup"] } }
    },
    {
      "name": "trims the title, and sends the times, a zero among them, and the typed nutrition",
      "patch": {
        "title": " Soup ",
        "prepMinutes": "10",
        "cookMinutes": "0",
        "nutritionSource": "MANUAL",
        "calories": "240",
        "proteinG": " "
      },
      "expected": {
        "input": {
          "title": "Soup",
          "description": "Warm.",
          "servings": 2,
          "prepMinutes": 10,
          "cookMinutes": 0,
          "nutritionSource": "MANUAL",
          "nutrition": { "calories": 240 }
        }
      }
    },
    {
      "name": "sends a note and a link, and leaves out a blank note and a line not to count",
      "patch": {
        "ingredients": [
          { "quantity": "250", "unit": "g", "name": "red lentils", "note": " rinsed ", "catalogSlug": "red-lentils" },
          { "quantity": "", "unit": "", "name": "salt", "note": "  ", "catalogSlug": "" }
        ]
      },
      "expected": {
        "input": {
          "ingredients": [
            { "quantity": 250, "unit": "g", "name": "red lentils", "note": "rinsed", "catalogSlug": "red-lentils" },
            { "name": "salt" }
          ]
        }
      }
    },
    {
      "name": "never sends both links for a line",
      "patch": {
        "ingredients": [
          { "quantity": "1", "unit": "servings", "name": "focaccia", "catalogSlug": "bread", "recipeId": "r-1" }
        ]
      },
      "expected": {
        "input": { "ingredients": [{ "quantity": 1, "unit": "servings", "name": "focaccia", "recipeId": "r-1" }] }
      }
    }
  ],
