{
  "base": {
    "title": "Soup",
    "description": "Warm.",
    "servings": "2",
    "prepMinutes": "",
    "cookMinutes": "",
    "tags": "",
    "nutritionSource": "INGREDIENTS",
    "calories": "",
    "proteinG": "",
