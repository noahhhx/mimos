{
  "orderCases": [
    {
      "name": "title sort ignores input order and case",
      "recipes": [
        { "id": "2", "title": "banana bread" },
        { "id": "3", "title": "Carrot soup" },
        { "id": "1", "title": "Apple tart" }
      ],
      "sort": "title",
      "tags": [],
      "expected": ["1", "2", "3"]
    },
    {
      "name": "title sort ignores accents, then breaks ties by id",
      "recipes": [
        { "id": "d", "title": "Zucchini" },
        { "id": "c", "title": "Éclair" },
        { "id": "b", "title": "eclair" },
        { "id": "a", "title": "Eclair" }
      ],
      "sort": "title",
      "tags": [],
      "expected": ["a", "b", "c", "d"]
    },
    {
      "name": "newest first, then by title",
      "recipes": [
        { "id": "1", "title": "Apple tart", "createdAt": "2025-01-02T00:00:00Z" },
        { "id": "3", "title": "Carrot soup", "createdAt": "2025-01-01T00:00:00Z" },
        { "id": "2", "title": "banana bread", "createdAt": "2025-01-03T00:00:00Z" },
        { "id": "4", "title": "Apple crumble", "createdAt": "2025-01-01T00:00:00Z" }
      ],
      "sort": "newest",
      "tags": [],
      "expected": ["2", "1", "4", "3"]
    },
    {
      "name": "oldest first, then by title",
      "recipes": [
        { "id": "2", "title": "banana bread", "createdAt": "2025-01-03T00:00:00Z" },
        { "id": "1", "title": "Apple tart", "createdAt": "2025-01-02T00:00:00Z" },
        { "id": "3", "title": "Carrot soup", "createdAt": "2025-01-01T00:00:00Z" }
      ],
      "sort": "oldest",
      "tags": [],
      "expected": ["3", "1", "2"]
    },
    {
      "name": "recently edited uses the update time, not the creation time",
      "recipes": [
        { "id": "a", "title": "A", "createdAt": "2025-01-01T00:00:00Z", "updatedAt": "2025-01-01T00:00:00Z" },
        { "id": "b", "title": "B", "createdAt": "2025-01-02T00:00:00Z", "updatedAt": "2025-01-03T00:00:00Z" },
        { "id": "c", "title": "C", "createdAt": "2025-01-03T00:00:00Z", "updatedAt": "2025-01-02T00:00:00Z" }
      ],
      "sort": "edited",
      "tags": [],
      "expected": ["b", "c", "a"]
    },
    {
      "name": "date sorts compare instants, not strings of different precision",
      "recipes": [
        { "id": "b", "title": "Late", "createdAt": "2025-01-01T00:00:00.5Z" },
        { "id": "a", "title": "Early", "createdAt": "2025-01-01T00:00:00Z" }
      ],
      "sort": "oldest",
      "tags": [],
      "expected": ["a", "b"]
    },
    {
      "name": "date sorts compare instants across offsets",
      "recipes": [
        { "id": "b", "title": "B", "createdAt": "2025-01-01T01:00:00+02:00" },
        { "id": "a", "title": "A", "createdAt": "2025-01-01T00:00:00Z" }
      ],
      "sort": "oldest",
      "tags": [],
      "expected": ["b", "a"]
    },
    {
      "name": "one tag keeps the recipes that have it",
      "recipes": [
        { "id": "1", "title": "Apple tart", "tags": ["dessert", "fruit"] },
        { "id": "2", "title": "banana bread", "tags": ["dessert"] },
        { "id": "3", "title": "Carrot soup", "tags": ["savoury"] }
      ],
      "sort": "title",
      "tags": ["dessert"],
      "expected": ["1", "2"]
    },
    {
      "name": "several tags keep the recipes that have all of them",
      "recipes": [
        { "id": "1", "title": "Apple tart", "tags": ["dessert", "fruit"] },
        { "id": "2", "title": "banana bread", "tags": ["dessert"] },
        { "id": "3", "title": "Carrot soup", "tags": ["savoury"] }
      ],
      "sort": "title",
      "tags": ["dessert", "fruit"],
      "expected": ["1"]
    },
    {
      "name": "a tag no recipe has keeps none",
      "recipes": [
        { "id": "1", "title": "Apple tart", "tags": ["dessert", "fruit"] },
        { "id": "2", "title": "banana bread", "tags": ["dessert"] }
      ],
      "sort": "title",
      "tags": ["missing"],
      "expected": []
    },
    {
      "name": "tags match exactly, case included",
      "recipes": [
        { "id": "1", "title": "Apple tart", "tags": ["Dessert"] },
        { "id": "2", "title": "banana bread", "tags": ["dessert"] }
      ],
      "sort": "title",
      "tags": ["dessert"],
      "expected": ["2"]
    },
    {
      "name": "a space sorts before a letter, so a shorter word first",
      "recipes": [
        { "id": "a0", "title": "Applesauce" },
        { "id": "b0", "title": "Apple tart" },
        { "id": "c0", "title": "Apple pie" }
      ],
      "sort": "title",
      "tags": [],
      "expected": ["c0", "b0", "a0"]
    },
    {
      "name": "a space sorts before a digit, and a digit before a letter",
      "recipes": [
        { "id": "a0", "title": "10 pie" },
        { "id": "b0", "title": "1 pie" },
        { "id": "c0", "title": "1pie" },
        { "id": "d0", "title": "Pie" }
      ],
      "sort": "title",
      "tags": [],
      "expected": ["b0", "a0", "c0", "d0"]
    },
    {
      "name": "a mark sorts before a letter",
      "recipes": [
        { "id": "a0", "title": "ab" },
        { "id": "b0", "title": "a-b" },
        { "id": "c0", "title": "a b" },
        { "id": "d0", "title": "a_b" }
      ],
      "sort": "title",
      "tags": [],
      "expected": ["c0", "d0", "b0", "a0"]
    },
    {
      "name": "a parenthesis sorts before a letter",
      "recipes": [
        { "id": "a0", "title": "Chicken roast" },
        { "id": "b0", "title": "Chicken (roast)" },
        { "id": "c0", "title": "Chicken, roast" }
      ],
      "sort": "title",
      "tags": [],
      "expected": ["b0", "a0", "c0"]
    },
    {
      "name": "ASCII marks, digits, and letters in the collation order",
      "recipes": [
        { "id": "a0", "title": "~" },
        { "id": "b0", "title": "a" },
        { "id": "c0", "title": "9" },
        { "id": "d0", "title": "$" },
        { "id": "e0", "title": "_" },
        { "id": "f0", "title": "-" },
        { "id": "g0", "title": "(" },
        { "id": "h0", "title": "!" },
        { "id": "i0", "title": "?" },
        { "id": "j0", "title": "#" },
        { "id": "k0", "title": "%" },
        { "id": "l0", "title": "0" },
        { "id": "m0", "title": "z" }
      ],
      "sort": "title",
      "tags": [],
      "expected": ["e0", "f0", "h0", "i0", "g0", "j0", "k0", "a0", "d0", "l0", "c0", "b0", "m0"]
    },
    {
      "name": "accented capitals and ligatures fold to their base letters",
      "recipes": [
        { "id": "a0", "title": "Zeta" },
        { "id": "b0", "title": "Æther" },
        { "id": "c0", "title": "Aether" },
        { "id": "d0", "title": "Ça va" },
        { "id": "e0", "title": "Cab" },
        { "id": "f0", "title": "Ølund" },
        { "id": "g0", "title": "Olive" },
        { "id": "h0", "title": "Œuvre" },
        { "id": "i0", "title": "Oeuf" },
        { "id": "j0", "title": "Straße" },
        { "id": "k0", "title": "Strasse" }
      ],
      "sort": "title",
      "tags": [],
      "expected": ["b0", "c0", "d0", "e0", "i0", "h0", "g0", "f0", "j0", "k0", "a0"]
    }
  ],
  "tagCases": [
    {
      "name": "distinct tags, ordered without regard to case",
      "recipes": [
        { "id": "1", "title": "A", "tags": ["Dinner", "quick"] },
        { "id": "2", "title": "B", "tags": ["dinner", "vegetarian"] }
      ],
      "expected": ["Dinner", "dinner", "quick", "vegetarian"]
    },
    {
      "name": "a tag spelled two ways keeps its first spelling first",
      "recipes": [
        { "id": "1", "title": "A", "tags": ["dinner"] },
        { "id": "2", "title": "B", "tags": ["Dinner", "Brunch"] }
      ],
      "expected": ["Brunch", "dinner", "Dinner"]
    },
    {
      "name": "no tags",
      "recipes": [{ "id": "1", "title": "A" }],
      "expected": []
    }
  ],
  "sortKeys": [
    { "key": "title", "expected": "title" },
    { "key": "newest", "expected": "newest" },
    { "key": "oldest", "expected": "oldest" },
    { "key": "edited", "expected": "edited" },
    { "key": "recent", "expected": "title" },
    { "key": "", "expected": "title" },
    { "key": null, "expected": "title" }
  ]
}
