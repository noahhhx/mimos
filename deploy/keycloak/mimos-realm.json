{
  "realm": "mimos",
  "displayName": "Mimos",
  "displayNameHtml": "<a href=\"${MIMOS_WEB_ORIGIN:http://localhost:3000}/\">Mimos</a>",
  "enabled": true,
  "loginTheme": "mimos",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "mimos-web",
      "name": "Mimos Web",
      "description": "Public browser client for the Mimos frontend.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["${MIMOS_WEB_ORIGIN:http://localhost:3000}/*"],
      "webOrigins": ["${MIMOS_WEB_ORIGIN:http://localhost:3000}"]
    },
    {
      "clientId": "mimos-agent",
      "name": "Mimos Agent",
      "description": "Public client for AI agents that connect over MCP (ADR-0014). Loopback redirect URIs match any port.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost/callback",
        "http://127.0.0.1/callback",
        "http://[::1]/callback",
        "https://claude.ai/api/mcp/auth_callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false"
      }
    }
  ],
  "users": [
    {
      "username": "test",
      "enabled": true,
      "realmRoles": ["default-roles-mimos"],
      "email": "test@example.com",
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Cook",
      "credentials": [
        {
          "type": "password",
          "value": "mimos-test",
          "temporary": false
        }
      ]
    },
    {
      "username": "test2",
      "enabled": true,
      "realmRoles": ["default-roles-mimos"],
      "email": "test2@example.com",
      "emailVerified": true,
      "firstName": "Second",
      "lastName": "Cook",
      "credentials": [
        {
          "type": "password",
          "value": "mimos-test",
          "temporary": false
        }
      ]
    }
  ]
}
