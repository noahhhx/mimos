# Copy to .env next to compose.yml and fill in. docs/self-hosting.md
# explains each setting.

# Image tag: `main` follows the main branch; a release tag (e.g. 1.2.0) or
# `latest` (the newest release) once releases are published.
MIMOS_VERSION=main

# The three public URLs your reverse proxy serves, HTTPS, no trailing slash.
WEB_ORIGIN=https://mimos.example.home
API_PUBLIC_URL=https://api.mimos.example.home
KEYCLOAK_PUBLIC_URL=https://auth.mimos.example.home

# Secrets: generate them, e.g. `openssl rand -base64 24`.
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

# Where the services listen on this machine for the reverse proxy.
# 127.0.0.1 when the proxy runs on this host; 0.0.0.0 when it runs elsewhere.
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8080
KEYCLOAK_PORT=8081
